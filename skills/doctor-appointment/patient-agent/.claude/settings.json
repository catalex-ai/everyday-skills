{
  "permissions": {
    "defaultMode": "dontAsk",
    "deny": [
      "Bash",
      "PowerShell",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "NotebookEdit",
      "Skill",
      "ToolSearch"
    ]
  },
  "disableAllHooks": true
}
