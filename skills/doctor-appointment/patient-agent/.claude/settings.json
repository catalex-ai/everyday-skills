{
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "mcp__clinic__book_my_appointment",
      "mcp__clinic__cancel_my_appointment",
      "mcp__clinic__get_available_slots",
      "mcp__clinic__get_clinic_information",
      "mcp__clinic__get_my_appointments",
      "mcp__clinic__reschedule_my_appointment",
      "Skill(clinic-role:appointments)"
    ],
    "deny": [
      "Bash",
      "PowerShell",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "NotebookEdit",
      "ToolSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../tools/tool_guard.py --role patient",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true
  }
}
